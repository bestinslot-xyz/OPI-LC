# Settings for `opi-indexer brc20 light` and `opi-indexer api`, the two
# services run.ubuntu.sh and run-api.ubuntu.sh install. Both read this file
# from this directory.

# ---- light client -----------------------------------------------------------

OPERATION_MODE="light"

# mainnet | signet
NETWORK_TYPE="mainnet"

# Light mode answers the BRC2.0 engine's Bitcoin lookups from this cache,
# filled from the OPI network, so it needs no bitcoind. It requires true.
BITCOIN_RPC_CACHE_ENABLED="true"

# Block reports to the OPI network. Set REPORT_TO_INDEXER to true and give the
# node a REPORT_NAME of its own to report.
REPORT_TO_INDEXER="false"
REPORT_NAME="opi-brc20-lc"

# false skips the per-block timing rows, which keeps the database smaller.
SAVE_LOGS="false"

# ---- database (shared by the light client and the API) ----------------------

DB_USER="postgres"
DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="postgres"
# Change this: run.ubuntu.sh refuses the default.
DB_PASSWD="postgres"
DB_SSL="true"

# ---- BRC2.0 engine ----------------------------------------------------------

# The engine runs inside `opi-indexer brc20 light`; its database lives here,
# relative to this directory.
BRC20_PROG_DB_PATH="data/brc20-prog"
# The engine's public JSON-RPC (eth_call, debug_traceTransaction). It takes no
# credentials, so keep it on loopback or firewall it.
BRC20_PROG_RPC_SERVER_URL="127.0.0.1:18545"

# ---- API (opi-indexer api) --------------------------------------------------

DB_MAX_CONNECTIONS="10"
API_HOST="127.0.0.1"
API_PORT="8000"
# Number of trusted proxies in front of the API; 1 behind an nginx reverse proxy.
API_TRUSTED_PROXY_CNT="0"
RATE_LIMIT_ENABLE="true"
RATE_LIMIT_WINDOW_MS="1000"
RATE_LIMIT_MAX="100"
