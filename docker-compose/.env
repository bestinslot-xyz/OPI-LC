# Settings for docker-compose.yml. The compose file sets the light-mode,
# database host and engine path keys itself.

# The OPI repository ref the image is built from: a branch or a release tag.
OPI_REF="opi-monolith"

# mainnet | signet
NETWORK_TYPE="mainnet"

# Password of the postgres user. Set it before the first start: Postgres keeps
# the first one.
DB_PASSWD="strong_password"

# Block reports to the OPI network. Set REPORT_TO_INDEXER to true and give the
# node a REPORT_NAME of its own to report.
REPORT_TO_INDEXER="false"
REPORT_NAME="opi-brc20-lc"

# The OPI API, published on all interfaces.
API_PORT="8000"
RATE_LIMIT_ENABLE="true"
RATE_LIMIT_WINDOW_MS="1000"
RATE_LIMIT_MAX="100"
